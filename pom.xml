    <!-- JClouds -->
    <jclouds.version>2.1.0</jclouds.version>
    <!-- JWT library-->
    <jwt.version>9.40</jwt.version>
    <!-- Query DSL (BOM-aligned; still javax-compatible) -->
    <querydsl.version>6.11</querydsl.version>
    <!-- Guava (was previously leaking transitively via QueryDSL 4.x, dropped in QueryDSL 5) -->
    <guava.version>33.7.1-jre</guava.version>
    <!-- Commons -->
    <commons.lang.version>3.20.0</commons.lang.version>
    <commons.codec.version>1.22.1</commons.codec.version>
    <!-- Testing -->
    <mockito.version>5.17.0</mockito.version>
    <junit.version>4.13.2</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <!-- Docker -->
    <docker.version>3.4.0</docker.version>
    <!-- Kubernetes client  -->
    <fabric8.version>6.13.4</fabric8.version>
    <!-- Consul -->
    <consul.version>1.4.5</consul.version>
    <!-- Drools -->
    <drools.version>10.2.0</drools.version>
    <!-- Openstack -->
    <openstack4j.version>3.2.0</openstack4j.version>
    <!-- Amazon (AWS SDK for Java v2) -->
    <amazon.version>2.54.4</amazon.version>
    <!-- PLUGINS -->
    <!-- Google Code style PLUGIN -->
    <code.style.plugin.version>3.0.0</code.style.plugin.version>
    <!-- Maven site PLUGIN -->
    <maven.attach.plugin.version>3.22.0</maven.attach.plugin.version>
    <!-- OWASP dependency-check PLUGIN (security-scan profile) -->
    <dependency.check.plugin.version>12.2.2</dependency.check.plugin.version>
  </properties>

  <dependencyManagement>
