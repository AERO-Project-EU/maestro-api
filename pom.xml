        <version>${jakarta.activation.version}</version>
      </dependency>

      <!-- Unirest Java -->
      <dependency>
        <groupId>com.konghq</groupId>
        <artifactId>unirest-java</artifactId>
        <version>${unirest.java.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
