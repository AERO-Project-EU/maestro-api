    <java.version.source>17</java.version.source>
    <java.version.target>17</java.version.target>
    <!-- Project Properties        -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <collector.version>1.1.0.RELEASE</collector.version>
    <!-- Spring Versions -->
    <spring.boot.version>3.5.16</spring.boot.version>
    <!-- Spring Thymeleaf (extras-springsecurity6): keep in step with the Thymeleaf
         version governed by the Boot BOM -->
    <spring.thymeleaf.version>3.1.5.RELEASE</spring.thymeleaf.version>
    <!-- Spring Framework: must match the version the Boot BOM imports. Only declared
         because the entries below carry explicit scopes (a managed dependency needs a version). -->
