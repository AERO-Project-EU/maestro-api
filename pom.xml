      </dependency>

      <!-- Amazon (AWS SDK for Java v2 BOM: governs software.amazon.awssdk:* versions) -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${amazon.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Logging -->
      <!-- Add Log4j2 Dependency -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-log4j2</artifactId>
        <version>${spring.boot.version}</version>
      </dependency>

      <!-- log4j-api is governed by the Boot BOM (log4j2.version); pinning it alone here would
           split it from log4j-core. Override the BOM property instead if it must move. -->

    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- JAVA compatibility + QueryDSL annotation processing (replaces the abandoned apt-maven-plugin) -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin}</version>
          <configuration>
            <source>${java.version.source}</source>
            <target>${java.version.target}</target>
            <!-- Spring Framework 6.1 requires parameter name metadata (removed the debug-symbol-based discoverer) -->
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>io.github.openfeign.querydsl</groupId>
                <artifactId>querydsl-apt</artifactId>
                <version>${querydsl.version}</version>
                <classifier>jakarta</classifier>
              </path>
              <path>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta.persistence.api.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>

        <!-- Google Code style -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${code.style.plugin.version}</version>
          <executions>
            <execution>
              <id>validate</id>
              <phase>validate</phase>
              <configuration>
                <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/maestro_google_checks.xml</configLocation>
                <encoding>UTF-8</encoding>
                <consoleOutput>true</consoleOutput>
                <failsOnError>true</failsOnError>
              </configuration>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- Maven site PLUGIN -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven.attach.plugin.version}</version>
          <executions>
            <execution>
              <id>attach-descriptor</id>
              <goals>
                <goal>attach-descriptor</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Opt-in security scan (not run on normal builds because it downloads the NVD database):
          mvn -Psecurity-scan verify
      Fails the build on any dependency with a CVSS >= 8 (High/Critical). Configure NVD_API_KEY
      as an environment variable / -Dnvd.api.key to speed up and avoid NVD rate limiting.
    -->
    <profile>
      <id>security-scan</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency.check.plugin.version}</version>
            <configuration>
              <failBuildOnCVSS>8</failBuildOnCVSS>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <!-- Reduce noise: skip false-positive-prone analyzers we do not need -->
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>aggregate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>