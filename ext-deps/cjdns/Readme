1) 	sudo apt-get install git build-essential nodejs python
		when pop-up displayed about restarting the services select: yes
2)	sudo mkdir -p /opt/cjdns
	sudo git clone --branch cjdns-v20.6 https://github.com/cjdelisle/cjdns.git /opt/cjdns
	cd /opt/cjdns
	sudo ./do
	sudo mkdir -p /etc/cjdns
	sudo chmod 755 /etc/cjdns
	./cjdroute --genconf > ~/cjdroute.conf

3)	sudo vim ~/cjdroute.conf
	place the following json object under the json path
	{
		"interfaces": {
			"UDPInterface": [
				{
					"connectTo": {
						//Place it here
					}
				}
			]
		}
	}
	"<peer-ip>:<peer-port>": {
        "login": "<peer-login>",
		"password": "<peer-password>",
		"publicKey": "<peer-public-key>",
		"peerName": "your-name-goes-here"
	}


4)	sudo mv ~/cjdroute.conf /etc/cjdns/cjdroute.conf
	sudo /opt/cjdns/cjdroute < /etc/cjdns/cjdroute.conf

		run ifconfig and verify that you have a tun0 interface

5)	Configure CJDNS as a service
	sudo wget http://www.jenovarain.com/blog/wp-content/uploads/2016/05/cjdns.txt
	sudo cp cjdns.txt /etc/init.d/cjdns
	sudo chmod +x /etc/init.d/cjdns
	sudo update-rc.d cjdns defaults
	sudo service cjdns start

6)	sudo vim /etc/docker/daemon.json
		and copy paste the following json
		{
		    "ipv6": true,
		    "fixed-cidr-v6": "2001:db8::/122"
		}

7)	netstat -ltup
		to find the ports that the cjdns is using