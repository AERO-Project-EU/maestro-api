# Copy to .env and fill in for your environment. .env is git-ignored.
# Property names follow Spring's relaxed binding: kafka.server.url -> KAFKA_SERVER_URL.

# Secrets (no defaults; the application will not work correctly without them) 
# Signs/encrypts tokens. Must match the virtualization-manager (token.signer.secret),
# the core-orchestrator (key.token) and the agent (AGENT_ENCRYPTION_KEY).
TOKEN_SIGNER_SECRET=
DATABASE_USERNAME=root
DATABASE_PASSWORD=
GRAFANA_TOKEN=
DNS_USERNAME=
DNS_PASSWORD=
RABBIT_MQ_USER=guest
RABBIT_MQ_PASSWORD=guest

# --- Endpoints ---
ORCHESTRATOR_SERVER_URL=http://localhost:8090
UI_SERVER_URL=http://localhost:8080
OSS_SERVER_URL=http://localhost:8200
KAFKA_SERVER_URL=http://localhost:9092
DATABASE_URL=127.0.0.1
DATABASE_PORT=3306
DNS_URL=localhost:9080
DNS_DOMAINS=
SPRING_DATA_MONGODB_USERNAME=user
SPRING_DATA_MONGODB_PASSWORD=pass

# --- Kubernetes providers seeded at startup (base64 encoded PEM) ---
# Cluster admin credentials: keep them out of the repository.
DATACLOUD_K8S_ENDPOINT=
DATACLOUD_K8S_CA_CERT=
DATACLOUD_K8S_CLIENT_CERT=
DATACLOUD_K8S_CLIENT_KEY=
RAINBOW_K8S_ENDPOINT=
RAINBOW_K8S_CA_CERT=
RAINBOW_K8S_CLIENT_CERT=
RAINBOW_K8S_CLIENT_KEY=
OPENSTACK_ENDPOINT=

# --- Seed data (development) ---
SEED_USER_PASSWORD_HASH=
NETDATA_PLUGIN_BASE_URL=
